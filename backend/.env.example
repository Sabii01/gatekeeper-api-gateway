# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=api_gateway_db

# Connection Pool Settings
PG_MAX_CLIENTS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Server Configuration (For upcoming phases)
PORT=5000
NODE_ENV=development
