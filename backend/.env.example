# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=api_gateway_db

# Connection Pool Settings
PG_MAX_CLIENTS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Redis (falls back to an embedded in-memory engine when unreachable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
PORT=5000
NODE_ENV=development

# Reverse Proxy Upstream (the bundled mock microservices listen on UPSTREAM_PORT)
UPSTREAM_PORT=5001
UPSTREAM_URL=http://localhost:5001
UPSTREAM_TIMEOUT_MS=10000
